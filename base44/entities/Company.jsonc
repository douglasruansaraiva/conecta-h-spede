{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da empresa/pousada/hotel"
    },
    "slug": {
      "type": "string",
      "description": "URL amig\u00e1vel \u00fanica para reservas p\u00fablicas"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do estabelecimento"
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logo"
    },
    "cover_image_url": {
      "type": "string",
      "description": "Imagem de capa"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "check_in_time": {
      "type": "string",
      "default": "14:00"
    },
    "check_out_time": {
      "type": "string",
      "default": "12:00"
    },
    "cancellation_policy": {
      "type": "string"
    },
    "payment_instructions": {
      "type": "string"
    },
    "owner_email": {
      "type": "string",
      "description": "Email do propriet\u00e1rio/admin"
    },
    "stripe_publishable_key": {
      "type": "string",
      "description": "Chave p\u00fablica do Stripe (pk_...)"
    },
    "stripe_secret_key": {
      "type": "string",
      "description": "Chave secreta do Stripe (sk_...)"
    }
  },
  "required": [
    "name",
    "slug",
    "owner_email"
  ]
}