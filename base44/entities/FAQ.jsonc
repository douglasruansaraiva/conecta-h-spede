{
  "name": "FAQ",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "question": {
      "type": "string",
      "description": "Pergunta"
    },
    "answer": {
      "type": "string",
      "description": "Resposta"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se o FAQ est\u00e1 ativo/vis\u00edvel"
    }
  },
  "required": [
    "company_id",
    "question",
    "answer"
  ]
}